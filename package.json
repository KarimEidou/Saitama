{
  "name": "saitama-one-punch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "One Punch Man open-world mobile game (WebGL2 / Three.js / Capacitor)",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "assets": "npm run assets:fetch && npm run assets:process",
    "assets:fetch": "tsx tools/fetch-assets.ts",
    "assets:process": "tsx tools/process-assets.ts",
    "verify": "tsx verification/verify.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,html,md}\"",
    "cap:android": "cap sync android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.4.2",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@gpu-tex-enc/basis": "^1.16.4",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.0",
    "@types/three": "^0.185.4",
    "draco3dgltf": "^1.5.7",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.5",
    "ffmpeg-static": "^5.3.0",
    "ktx-parse": "^1.1.0",
    "ktx2tools": "^1.1.0",
    "meshoptimizer": "^1.2.0",
    "playwright": "1.56.1",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
