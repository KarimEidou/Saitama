# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# Asset pipeline working directories.
# `assets/source/`    = raw third-party downloads (large, re-fetchable via `npm run assets:fetch`)
# `assets/generated/` = processed/compressed output (re-derivable via `npm run assets:process`)
# The asset MANIFEST itself is tracked — only the binaries are ignored.
assets/source/
assets/generated/
# `public/assets/` = the GPU-native build `npm run assets:process` emits (KTX2,
# GLB, the generated `assets.runtime.json` index). Vite serves `public/` at the
# web root, so this is what the game actually fetches. Re-derivable; never committed.
public/assets/

# Native platform projects — GENERATED, deliberately not committed.
#
# `android/` is fully derived from `capacitor.config.ts` + `package.json`, and it
# CANNOT be tracked as-is: `npm run guard` rejects any tracked `.png` outside
# `docs/screenshots/`, and a Capacitor project ships 26 launcher/splash PNGs under
# `android/app/src/main/res/`. Committing it would need the guard's format rule
# weakened repo-wide, which is a worse trade than regenerating. (Size is not the
# problem — the largest generated file is the 43 KB gradle wrapper jar.)
#
# Regenerate from a clean checkout:
#   npx tsx scripts/android-sdk.ts        # install Android SDK (idempotent, ~830 MB)
#   npm run build && npx cap add android  # dist/ must exist first
#   npx tsx scripts/build-apk.ts          # -> android/app/build/outputs/apk/debug/
android/
ios/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Environment
.env
.env.local
.env.*.local

# Test / verification artifacts.
# Screenshots produced by the verification harness live here but are NOT
# committed — the binary guard permits committed images only under
# docs/screenshots/, where a small curated evidence copy is kept instead.
playwright-report/
test-results/
verification/*.tmp/
verification/*.png
verification/*.jpg
verification/*.webm

# Agent scratch/probe files (temporary; must never be tracked or trip lint)
.probe*.mjs
.audio-scratch/
.*-scratch/
.probe*.ts

.*scratch*
.*-audit-notes.md

# Generated app icons (npx tsx scripts/make-icons.ts)
public/icons/
public/manifest.webmanifest
