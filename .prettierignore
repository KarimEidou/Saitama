# Build outputs and downloads. Prettier does not read .gitignore, so the
# generated trees must be repeated here or `format`/`format:check` walk them.
dist/
node_modules/
android/
ios/
assets/source/
assets/generated/
public/assets/
public/icons/
playwright-report/
test-results/

# Machine-written files: their generators own the byte layout. Formatting them
# creates a permanent churn loop — the next pipeline run reverts the formatting.
docs/screenshots/*.json
verification/playthrough-report.json
# Written by `verification/integration.verify.ts` exactly as the line above is
# written by the playthrough driver. Untracked, so a clean checkout never has
# it — and a tree that has just run the integration driver failed `format:check`
# on an artefact nobody authored.
verification/integration-report.json
